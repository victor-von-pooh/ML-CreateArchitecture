  "paths": {
    "/api/units": {
      "get": {
        "summary": "List Units",
        "description": "部品の一覧を返す関数\n\nParameters\n----------\nNone\n\nReturns\n----------\nunits: list[dict[str, Any]]\n    ML-ModelControl の部品ごとの名前, 説明, 引数, 口",
        "operationId": "list_units",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Units"
                }
              }
            }
          }
        }
      }
    },
    "/api/check": {
      "post": {
        "summary": "Check Spec",
        "description": "モデルの定義を確かめ, 誤りがなければ形を推定する関数\n\nParameters\n----------\nbody: SpecBody\n    モデルの定義と, 形の推定もするか\n\nReturns\n----------\nresult: CheckResult\n    誤りと注意, ノードごとの形とパラメータ数, YAML",
        "operationId": "check_spec",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/export": {
      "post": {
        "summary": "Export Spec",
        "description": "モデルの定義から Python のコードを書き出す関数\n\nParameters\n----------\nbody: ExportBody\n    モデルの定義とクラスの名前\n\nReturns\n----------\nresult: ExportResult\n    Python のコード",
        "operationId": "export_spec",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pretrained": {
      "post": {
        "summary": "Read Pretrained",
        "description": "ノードが読む学習済みの重みのライセンスを, 配布元から読んで返す関数\n\n結果は ML-ModelControl がプロセスの中に覚えるので, 同じモデルを何度\n選んでもネットワークは 1 回だけ使う\n\nParameters\n----------\nbody: PretrainedBody\n    部品の名前と引数の値\n\nReturns\n----------\ninfo: Optional[PretrainedInfo]\n    ライセンスの情報, 重みを読まない場合は null",
        "operationId": "read_pretrained",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PretrainedBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PretrainedInfo"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Read Pretrained"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/weights": {
      "post": {
        "summary": "Read Weights",
        "description": "定義を組み立てて外部の重みを読み, ノードごとの報告を返す関数\n\nファイルとネットワークを使い重みも作るので, 編集のたびの確認では\n呼ばず, 画面のボタンを押したときだけ呼ぶ\n\nParameters\n----------\nbody: WeightsBody\n    モデルの定義\nrequest: Request\n    リクエスト (相対のパスの元にする定義の置き場を取り出す)\n\nReturns\n----------\nresult: WeightsResult\n    読めたか, ノードごとの報告, 読めない場合の誤りの文",
        "operationId": "read_weights",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeightsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeightsResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples": {
      "get": {
        "summary": "List Example Models",
        "description": "ML-ModelControl に同梱した例のモデルの一覧を返す関数\n\nParameters\n----------\nNone\n\nReturns\n----------\nexamples: list[ExampleSummary]\n    例の名前と説明",
