    "/api/models": {
      "get": {
        "summary": "List Models",
        "description": "保存した定義の一覧を返す関数\n\nParameters\n----------\nrequest: Request\n    リクエスト\n\nReturns\n----------\nmodels: list[ModelSummary]\n    名前と更新時刻 (新しい順)",
