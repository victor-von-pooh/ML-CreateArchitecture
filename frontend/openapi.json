{
  "openapi": "3.1.0",
  "info": {
    "title": "ML-CreateArchitecture",
    "version": "0.1.0"
  },
  "paths": {
    "/api/units": {
      "get": {
        "summary": "List Units",
        "description": "部品の一覧を返す関数\n\nParameters\n----------\nNone\n\nReturns\n----------\nunits: list[dict[str, Any]]\n    ML-ModelControl の部品ごとの名前, 説明, 引数, 口",
        "operationId": "list_units",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Units"
                }
              }
            }
          }
        }
      }
    },
    "/api/modules": {
      "get": {
        "summary": "List Custom Modules",
        "description": "起動の設定で読み込んだ自作の部品のモジュールを返す関数\n\nParameters\n----------\nrequest: Request\n    リクエスト\n\nReturns\n----------\ninfo: ModulesInfo\n    環境変数の名前と, モジュールごとの部品の名前",
        "operationId": "list_custom_modules",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModulesInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/check": {
      "post": {
        "summary": "Check Spec",
        "description": "モデルの定義を確かめ, 誤りがなければ形を推定する関数\n\nParameters\n----------\nbody: SpecBody\n    モデルの定義と, 形の推定もするか\n\nReturns\n----------\nresult: CheckResult\n    誤りと注意, ノードごとの形とパラメータ数, YAML",
        "operationId": "check_spec",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/export": {
      "post": {
        "summary": "Export Spec",
        "description": "モデルの定義から Python のコードを書き出す関数\n\nParameters\n----------\nbody: ExportBody\n    モデルの定義とクラスの名前\n\nReturns\n----------\nresult: ExportResult\n    Python のコード",
        "operationId": "export_spec",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pretrained": {
      "post": {
        "summary": "Read Pretrained",
        "description": "ノードが読む学習済みの重みのライセンスを, 配布元から読んで返す関数\n\n結果は ML-ModelControl がプロセスの中に覚えるので, 同じモデルを何度\n選んでもネットワークは 1 回だけ使う\n\nParameters\n----------\nbody: PretrainedBody\n    部品の名前と引数の値\n\nReturns\n----------\ninfo: Optional[PretrainedInfo]\n    ライセンスの情報, 重みを読まない場合は null",
        "operationId": "read_pretrained",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PretrainedBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PretrainedInfo"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Read Pretrained"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/weights": {
      "post": {
        "summary": "Read Weights",
        "description": "定義を組み立てて外部の重みを読み, ノードごとの報告を返す関数\n\nファイルとネットワークを使い重みも作るので, 編集のたびの確認では\n呼ばず, 画面のボタンを押したときだけ呼ぶ\n\nParameters\n----------\nbody: WeightsBody\n    モデルの定義\nrequest: Request\n    リクエスト (相対のパスの元にする定義の置き場を取り出す)\n\nReturns\n----------\nresult: WeightsResult\n    読めたか, ノードごとの報告, 読めない場合の誤りの文",
        "operationId": "read_weights",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeightsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeightsResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples": {
      "get": {
        "summary": "List Example Models",
        "description": "ML-ModelControl に同梱した例のモデルの一覧を返す関数\n\nParameters\n----------\nNone\n\nReturns\n----------\nexamples: list[ExampleSummary]\n    例の名前と説明",
        "operationId": "list_example_models",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExampleSummary"
                  },
                  "type": "array",
                  "title": "Response List Example Models"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples/{name}": {
      "get": {
        "summary": "Get Example",
        "description": "例のモデルの定義を読み込む関数\n\nParameters\n----------\nname: str\n    例の名前\n\nReturns\n----------\nmodel: ModelFile\n    例の名前と定義",
        "operationId": "get_example",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelFile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "summary": "List Models",
        "description": "保存した定義の一覧を返す関数\n\nParameters\n----------\nrequest: Request\n    リクエスト\n\nReturns\n----------\nmodels: list[ModelSummary]\n    名前と更新時刻 (新しい順)",
        "operationId": "list_models",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelSummary"
                  },
                  "type": "array",
                  "title": "Response List Models"
                }
              }
            }
          }
        }
      }
    },
    "/api/models/{name}": {
      "get": {
        "summary": "Get Model",
        "description": "保存した定義を読み込む関数\n\nParameters\n----------\nname: str\n    定義の名前\nrequest: Request\n    リクエスト\n\nReturns\n----------\nmodel: ModelFile\n    定義の名前と中身",
        "operationId": "get_model",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelFile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save Model",
        "description": "定義を保存する関数 (誤りがあっても途中の状態として保存できる)\n\nParameters\n----------\nname: str\n    定義の名前\nbody: SpecBody\n    モデルの定義\nrequest: Request\n    リクエスト\n\nReturns\n----------\nsummary: ModelSummary\n    保存した定義の名前と更新時刻",
        "operationId": "save_model",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Model",
        "description": "保存した定義を消す関数\n\nParameters\n----------\nname: str\n    定義の名前\nrequest: Request\n    リクエスト\n\nReturns\n----------\nNone",
        "operationId": "delete_model",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dataset/inputs": {
      "post": {
        "summary": "Read Dataset Inputs",
        "description": "データセットから, モデルの入力と出す値の数を読む関数\n\nParameters\n----------\nbody: PathBody\n    データセットのディレクトリ\n\nReturns\n----------\nresult: DatasetInputs\n    入力 (形はバッチの次元を例の大きさにしたものと, データセットの\n    形), タスク, 目的の列, クラス, 正解の種類, 出す値の数\n\nRaises\n----------\nHTTPException\n    ML-EDA が無い場合は 501, ディレクトリか説明が無い場合は 404,\n    読めない場合 (知らない版, 知らない項目の組など) は 422",
        "operationId": "read_dataset_inputs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PathBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetInputs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/problems": {
      "get": {
        "summary": "List Problems",
        "description": "ML-Pathfinder の置き場にある問題の設定の一覧を返す関数\n\nParameters\n----------\nNone\n\nReturns\n----------\nresult: ProblemList\n    置き場の problems, 問題の設定 (更新の新しい順), 置き場を読めない\n    場合の理由\n\nRaises\n----------\nHTTPException\n    ML-Quest が無い場合は 501",
        "operationId": "list_problems",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemList"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/target": {
      "post": {
        "summary": "Project Target",
        "description": "プロジェクトのモデルの定義の保存先を返す関数\n\nParameters\n----------\nbody: TargetBody\n    プロジェクトのディレクトリか問題の設定のファイルと, models/ の下の\n    名前\n\nReturns\n----------\ntarget: ProjectTarget\n    保存先, プロジェクトとデータセットの場所, 既にあるか",
        "operationId": "project_target",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectTarget"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/model": {
      "put": {
        "summary": "Save Project Model",
        "description": "定義をプロジェクトの保存先に書く関数\n\nParameters\n----------\nbody: ProjectSaveBody\n    保存先を決める場所, models/ の下の名前, 定義, 上書きするか\n\nReturns\n----------\nsaved: ProjectSaved\n    書いたファイルと更新時刻\n\nRaises\n----------\nHTTPException\n    確かめた保存先 (target) と違う場合と, 既にあり上書きしない場合は\n    409, 定義を読めない場合は 422, 書けない場合は 500 (他は保存先を\n    決めるときと同じ)",
        "operationId": "save_project_model",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectSaveBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSaved"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Issues"
          },
          "inferred": {
            "type": "boolean",
            "title": "Inferred"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": false
          },
          "nodes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/NodeResult"
            },
            "type": "object",
            "title": "Nodes",
            "default": {}
          },
          "outputs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Outputs",
            "default": {}
          },
          "params": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "trainable": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trainable"
          },
          "estimated_only": {
            "type": "boolean",
            "title": "Estimated Only",
            "default": false
          },
          "yaml": {
            "type": "string",
            "title": "Yaml",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "issues",
          "inferred"
        ],
        "title": "CheckResult"
      },
      "CustomModule": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "units": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Units"
          }
        },
        "type": "object",
        "required": [
          "name",
          "units"
        ],
        "title": "CustomModule"
      },
      "DatasetInput": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "shape": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Shape"
          },
          "dtype": {
            "type": "string",
            "title": "Dtype"
          },
          "dataset_shape": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Dataset Shape",
            "description": "model_inputs の形 (決まらない次元は null)"
          },
          "vocabulary": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
