            "description": "文の語の番号の入力の語彙の大きさ (埋め込みの数)"
          }
        },
        "type": "object",
        "required": [
          "name",
          "shape",
          "dtype"
        ],
        "title": "DatasetInput"
      },
      "DatasetInputs": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/DatasetInput"
            },
            "type": "array",
            "title": "Inputs"
          },
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "classes": {
            "anyOf": [
              {
                "items": {},
